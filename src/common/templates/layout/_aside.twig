{% import "common/templates/components/_sidebar-item.twig" as sidebar %}
<aside class="aside">
    <header class="aside-header">
      <a href="#" class="logo-link">
        <img
            class="logo"
            src="./assets/images/logo.svg"
            alt="Logo OrangeFarm"
            width="148" height="40">
        <img
            class="logo-sm"
            src="./assets/images/logo-sm.svg"
            alt="Logo OrangeFarm"
            width="21" height="40">
      </a>
    </header>
    <div class="aside-main">
        {% include 'common/templates/components/_aside-search.twig' %}
        {{ sidebar.sidebarList([
            { text: 'Dashboard', isActive: true, icon: 'icon-layout-collage' },
            { text: 'Customers', icon: 'icon-users',
              dropdown: [
                { text: '<b>Chris Friedkly</b><small>Supermarket Villanova</small>', img: './assets/images/avatar-1.avif'},
                { text: '<b>Maggie Johnson</b><small>Oasis Organic Inc.</small>', img: './assets/images/avatar-2.avif'},
                { text: '<b>Gael Harry</b><small>New York Finest Fruits</small>', img: './assets/images/avatar-3.avif'},
                { text: '<b>Jenna Sullivan</b><small>Walmart</small>', img: './assets/images/avatar-4.avif'},
              ] },
            { text: 'All reports', icon: 'icon-clipboard-data' },
            { text: 'Geography', icon: 'icon-world' },
            { text: 'Conversations', icon: 'icon-message-circle' },
            { text: 'Deals', icon: 'icon-basket-check' },
            { text: 'Export', icon: 'icon-database-export' }
        ]) }}
    </div>
    <footer class="aside-footer">
        {% include 'common/templates/components/_profile-button.twig' %}
        <ul class="footer-list">
            <li class="footer-list-item">
                {{ sidebar.sidebarItem({
                    text: 'Settings',
                    icon: 'icon-settings-2'
                }) }}
            </li>
            <li class="footer-list-item">
                {{ sidebar.sidebarItem({
                    text: 'Log out',
                    icon: 'icon-logout',
                    classes: 'log-out'
                }) }}
            </li>
        </ul>
    </footer>
    {% include 'common/templates/components/_collapse-button.twig' %}
</aside>
{% include 'common/templates/js/_sidebar-dropdown.twig' %}
{% include 'common/templates/js/_aside-collapse.twig' %}
