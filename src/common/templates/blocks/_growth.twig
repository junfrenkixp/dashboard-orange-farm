<div class="growth-wrap">
  <div class="widget growth">
    <div class="widget-inner">
        <h2 class="widget-title">Growth</h2>
        {% include "common/templates/components/_widget-dropdown.twig" with {
            buttonContent: 'Yearly',
            dropdownId: 'chart-period',
            items: [
                { label: 'Yearly', value: 'yearly' },
                { label: 'Monthly', value: 'monthly' },
                { label: 'All', value: 'all' }
            ]
        } only %}
        <div id="growthChart"></div>
    </div>
  </div>
  <div class="widget widget-sm growth-sm growth-month">
    <div class="widget-inner">
      <h2 class="growth-sm-title">Top month</h2>
      <span>
        <b>November</b>
        2019
      </span>
    </div>
  </div>
  <div class="widget widget-sm growth-sm growth-year">
    <div class="widget-inner">
      <h2 class="growth-sm-title">Top year</h2>
      <span>
        <b>2023</b>
        96K sold so far
      </span>
    </div>
  </div>
  <div class="widget widget-sm growth-sm growth-top">
    <div class="widget-inner">
      <h2 class="growth-sm-title">Top buyer</h2>
      <a href="#">
        <img src="./assets/images/avatar-2.avif" alt="" width="24" height="24">
        <b>Maggie Johnson</b>
        <small>Oasis Organic Inc.</small>
      </a>
    </div>
  </div>
</div>
