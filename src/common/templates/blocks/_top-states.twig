<div class="widget top-states">
    <div class="widget-inner">
        <div class="widget-title">Top states</div>
        <ul class="top-states-list">
          {% set statesLine = [
            { 'label': 'NY', 'value': '120k', 'percent': '100%' },
            { 'label': 'MA', 'value': '80k', 'percent': '85%' },
            { 'label': 'NH', 'value': '70k', 'percent': '75%' },
            { 'label': 'OR', 'value': '50k', 'percent': '65%' },
          ] %}
          {% for line in statesLine %}
            <li style="width: {{ line.percent }}">
              <b>{{ line.label }}</b>
              <small>{{ line.value }}</small>
            </li>
          {% endfor %}
        </ul>
    </div>
</div>
